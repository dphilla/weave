(module
  (import "env" "emit32" (func $emit32 (param i32)))
  (memory $scratch 1 4)
  (memory $secondary 1 3)
  (data $bytes "xy")
  ;; The checkpoint can land in this callee with SIMD values live in both
  ;; frames. Alternate memory-1 lane/zero loads with memory-0 scalar loads.
  (func $step (param $v v128) (result v128)
    (local $j i32)
    (v128.store32_lane $secondary 0 (i32.const 96) (local.get $v))
    (if (i32.ne
          (i32x4.extract_lane 0 (v128.load32_zero $secondary (i32.const 96)))
          (i32x4.extract_lane 0 (local.get $v)))
      (then unreachable))
    (if (i32.ne (i32.load $scratch (i32.const 0)) (i32.const 33))
      (then unreachable))
    (loop $once
      (local.set $v (i32x4.add (local.get $v) (v128.const i32x4 1 2 3 4)))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br_if $once (i32.lt_u (local.get $j) (i32.const 1))))
    (local.get $v))
  (func (export "run") (param $n i32) (result i32)
    (local $i i32) (local $v v128)
    (if (i32.ne (memory.grow $secondary (i32.const 1)) (i32.const 1))
      (then unreachable))
    (if (i32.ne (memory.grow $secondary (i32.const 3)) (i32.const -1))
      (then unreachable))
    (i32.store $scratch (i32.const 0) (i32.const 33))
    (i32.store $secondary (i32.const 0) (i32.const 99))
    (memory.copy $secondary $scratch (i32.const 32) (i32.const 0) (i32.const 4))
    (memory.fill $secondary (i32.const 64) (i32.const 42) (i32.const 4))
    (memory.init $secondary $bytes (i32.const 80) (i32.const 0) (i32.const 2))
    (data.drop $bytes)
    (call $emit32 (i32.const 0))
    (local.set $v (v128.const i32x4 1 2 3 4))
    (loop $work
      (local.set $v (call $step (local.get $v)))
      (if (i32.ne (i32.load $scratch (i32.const 0)) (i32.const 33))
        (then unreachable))
      (v128.store $secondary (i32.const 65536) (local.get $v))
      (local.set $v (v128.load $secondary (i32.const 65536)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $work (i32.lt_u (local.get $i) (local.get $n))))
    (call $emit32 (local.get $i))
    (i32.add
      (i32.add (i32x4.extract_lane 0 (local.get $v)) (memory.size $secondary))
      (i32.add
        (i32.load $secondary (i32.const 32))
        (i32.add
          (i32.load8_u $secondary (i32.const 64))
          (i32.load8_u $secondary (i32.const 80))))))
  (func (export "simd_oob") (result v128)
    (v128.load $secondary (i32.const 65528)))
  (func (export "copy_oob")
    (memory.copy $scratch $secondary (i32.const 0) (i32.const 65535) (i32.const 2)))
  (func (export "fill_oob")
    (memory.fill $secondary (i32.const 65535) (i32.const 0) (i32.const 2))))
