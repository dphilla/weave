{
  "name": "weave-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "weave-workspace",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@weave-net/browser-transports": {
      "resolved": "packages/browser-transports",
      "link": true
    },
    "node_modules/@weave-net/node-transports": {
      "resolved": "packages/node-transports",
      "link": true
    },
    "node_modules/@weave-net/webrtc-session": {
      "resolved": "packages/webrtc-session",
      "link": true
    },
    "node_modules/@weave-net/ws-tcp-gateway": {
      "resolved": "packages/ws-tcp-gateway",
      "link": true
    },
    "packages/browser-transports": {
      "name": "@weave-net/browser-transports",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=18"
      }
    },
    "packages/node-transports": {
      "name": "@weave-net/node-transports",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=18"
      }
    },
    "packages/webrtc-session": {
      "name": "@weave-net/webrtc-session",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=18"
      }
    },
    "packages/ws-tcp-gateway": {
      "name": "@weave-net/ws-tcp-gateway",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=18"
      }
    }
  }
}
